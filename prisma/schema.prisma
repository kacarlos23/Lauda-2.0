generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  GLOBAL_ADMIN
  TENANT_ADMIN
  MINISTRY_LEADER
  MEMBER
}

enum AssignmentStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum MemberStatus {
  PENDING
  ACTIVE
  INACTIVE
}

enum PermissionEffect {
  ALLOW
  DENY
}

enum NotificationType {
  SCHEDULE_ASSIGNED
  SCHEDULE_UPDATED
  SCHEDULE_CANCELLED
  ASSIGNMENT_ROLE_CHANGED
  ASSIGNMENT_REMOVED
  ASSIGNMENT_ACCEPTED
  ASSIGNMENT_DECLINED
  SUBSTITUTION_REQUESTED
  SUBSTITUTION_RESOLVED
}

enum PushPlatform {
  ANDROID
  IOS
}

enum PushDeliveryStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
  DEVICE_INVALID
}

model Tenant {
  id        String    @id @default(uuid())
  name      String
  comments  String?   @db.Text
  domain    String?   @unique
  isActive  Boolean   @default(true)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  users               User[]
  ministries          Ministry[]
  schedules           Schedule[]
  songs               Song[]
  artists             Artist[]
  memberInvites       MemberInvite[]
  instruments         Instrument[]
  userPermissions     UserPermission[]
  authSessions        AuthSession[]
  supportAccessGrants SupportAccessGrant[]

  ministryMembers     MinistryMember[]
  scheduleAssignments ScheduleAssignment[]
  scheduleSongs       ScheduleSong[]
  ministrySongs       MinistrySong[]
  userInstruments     UserInstrument[]
  adminAuditLogs      AdminAuditLog[]
  domainEvents        DomainEventOutbox[]
  notifications       Notification[]
  pushDevices         PushDevice[]
}

model MemberInvite {
  id String @id @default(uuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  ministryId String?
  ministry   Ministry? @relation(fields: [ministryId], references: [id], onDelete: Cascade)

  code      String    @unique
  active    Boolean   @default(true)
  isActive  Boolean   @default(true)
  deletedAt DateTime?
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([tenantId])
  @@index([ministryId])
  @@index([active])
}

model User {
  id                 String    @id @default(uuid())
  email              String    @unique
  password           String
  name               String
  phone              String?
  avatarUrl          String?   @db.Text
  comments           String?   @db.Text
  role               Role      @default(MEMBER)
  isActive           Boolean   @default(true)
  deletedAt          DateTime?
  mfaSecretEncrypted String?   @db.Text
  mfaEnabledAt       DateTime?

  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  ministries           MinistryMember[]
  schedules            ScheduleAssignment[]
  instruments          UserInstrument[]
  createdSongs         Song[]               @relation("SongCreatedBy")
  updatedSongs         Song[]               @relation("SongUpdatedBy")
  permissions          UserPermission[]     @relation("UserPermissionUser")
  grantedPermissions   UserPermission[]     @relation("UserPermissionGrantedBy")
  authSessions         AuthSession[]
  supportAccessGrants  SupportAccessGrant[] @relation("SupportAccessGrantee")
  grantedSupportAccess SupportAccessGrant[] @relation("SupportAccessGrantor")
  createdSchedules      Schedule[]           @relation("ScheduleCreatedBy")
  receivedNotifications Notification[]       @relation("NotificationRecipient")
  actedNotifications    Notification[]       @relation("NotificationActor")
  domainEvents           DomainEventOutbox[]  @relation("DomainEventActor")
  pushDevices            PushDevice[]

  resetPasswordToken         String?   @unique
  resetPasswordChallengeId   String?   @unique
  resetPasswordPepperVersion Int?
  resetPasswordAttempts      Int       @default(0)
  resetPasswordConsumedAt    DateTime?
  resetPasswordExpires       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

model AuthSession {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantId        String?
  tenant          Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userAgent       String?
  ipAddress       String?
  createdAt       DateTime  @default(now())
  lastUsedAt      DateTime  @default(now())
  expiresAt       DateTime
  revokedAt       DateTime?
  revokeReason    String?
  mfaVerifiedAt   DateTime?
  stepUpExpiresAt DateTime?

  refreshFamily RefreshTokenFamily?

  @@index([userId, revokedAt])
  @@index([tenantId, revokedAt])
  @@index([expiresAt])
}

model SupportAccessGrant {
  id              String    @id @default(uuid())
  granteeId       String
  grantee         User      @relation("SupportAccessGrantee", fields: [granteeId], references: [id], onDelete: Cascade)
  grantedById     String
  grantedBy       User      @relation("SupportAccessGrantor", fields: [grantedById], references: [id], onDelete: Restrict)
  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  resource        String
  resourceId      String?
  scopes          String[]
  ticketReference String
  reason          String
  expiresAt       DateTime
  boundSessionId  String?
  lastUsedAt      DateTime?
  revokedAt       DateTime?
  revokeReason    String?
  createdAt       DateTime  @default(now())

  @@index([granteeId, revokedAt, expiresAt])
  @@index([tenantId, resource, resourceId])
  @@index([grantedById])
  @@index([boundSessionId])
}

model RefreshTokenFamily {
  id           String      @id @default(uuid())
  sessionId    String      @unique
  session      AuthSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  createdAt    DateTime    @default(now())
  revokedAt    DateTime?
  revokeReason String?

  tokens RefreshToken[]

  @@index([revokedAt])
}

model RefreshToken {
  id            String             @id @default(uuid())
  familyId      String
  family        RefreshTokenFamily @relation(fields: [familyId], references: [id], onDelete: Cascade)
  jti           String             @unique
  tokenHash     String             @unique
  createdAt     DateTime           @default(now())
  expiresAt     DateTime
  consumedAt    DateTime?
  revokedAt     DateTime?
  replacedByJti String?

  @@index([familyId, consumedAt])
  @@index([expiresAt])
}

model Instrument {
  id        String    @id @default(uuid())
  name      String
  colorHex  String?
  isActive  Boolean   @default(true)
  deletedAt DateTime?

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  members UserInstrument[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, name])
  @@index([tenantId])
}

model UserInstrument {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  instrumentId String
  instrument   Instrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)

  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  isActive  Boolean   @default(true)
  deletedAt DateTime?

  createdAt DateTime @default(now())

  @@unique([userId, instrumentId])
  @@index([tenantId])
  @@index([instrumentId])
}

model Ministry {
  id          String    @id @default(uuid())
  name        String
  description String?
  comments    String?   @db.Text
  isActive    Boolean   @default(true)
  deletedAt   DateTime?

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  members       MinistryMember[]
  memberInvites MemberInvite[]
  schedules     Schedule[]
  songs         MinistrySong[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

model MinistryMember {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  ministryId String
  ministry   Ministry @relation(fields: [ministryId], references: [id], onDelete: Cascade)

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  roleId    String?
  role      String?
  skills    String[]     @default([])
  status    MemberStatus @default(PENDING)
  joinedAt  DateTime     @default(now())
  notes     String?
  isLeader  Boolean      @default(false)
  isActive  Boolean      @default(true)
  deletedAt DateTime?
  createdAt DateTime     @default(now())

  @@unique([userId, ministryId])
  @@index([ministryId])
  @@index([ministryId, status])
  @@index([tenantId])
}

model Schedule {
  id        String    @id @default(uuid())
  title     String
  date      DateTime
  comments  String?   @db.Text
  isActive  Boolean   @default(true)
  deletedAt DateTime?

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  ministryId String
  ministry   Ministry @relation(fields: [ministryId], references: [id], onDelete: Cascade)

  createdById String?
  createdBy   User?   @relation("ScheduleCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  assignments ScheduleAssignment[]
  songs       ScheduleSong[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([tenantId, date])
  @@index([ministryId])
  @@index([createdById])
  @@index([tenantId, ministryId, date])
}

model ScheduleSong {
  id String @id @default(uuid())

  scheduleId String
  schedule   Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  songId String
  song   Song   @relation(fields: [songId], references: [id], onDelete: Cascade)

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  order     Int       @default(0)
  isActive  Boolean   @default(true)
  deletedAt DateTime?
  createdAt DateTime  @default(now())

  @@unique([scheduleId, songId])
  @@index([tenantId])
  @@index([tenantId, scheduleId])
  @@index([songId])
}

model ScheduleAssignment {
  id String @id @default(uuid())

  scheduleId String
  schedule   Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  role     String // ex: "Guitarrista", "Bateria", "Recepção"
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  status                   AssignmentStatus @default(PENDING)
  isActive                 Boolean          @default(true)
  deletedAt                DateTime?
  declineReason            String?
  substituteRequestedAt    DateTime?
  substituteResolvedAt     DateTime?
  substituteResolvedById   String?
  substituteResolutionNote String?
  createdAt                DateTime         @default(now())

  @@unique([scheduleId, userId])
  @@index([tenantId])
  @@index([tenantId, userId])
  @@index([tenantId, status])
  @@index([tenantId, substituteRequestedAt, substituteResolvedAt])
}

model DomainEventOutbox {
  id            String   @id @default(uuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actorId       String?
  actor         User?    @relation("DomainEventActor", fields: [actorId], references: [id], onDelete: SetNull)
  type          String
  aggregateType String
  aggregateId   String
  payload       Json
  occurredAt    DateTime @default(now())
  publishedAt   DateTime?
  attempts      Int      @default(0)
  nextAttemptAt DateTime @default(now())
  lastError     String?

  notifications Notification[]

  @@index([publishedAt, nextAttemptAt])
  @@index([tenantId, aggregateType, aggregateId])
}

model Notification {
  id          String           @id @default(uuid())
  tenantId    String
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId      String
  user        User             @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actorId     String?
  actor       User?            @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  eventId     String
  event       DomainEventOutbox @relation(fields: [eventId], references: [id], onDelete: Cascade)
  type        NotificationType
  resourceType String
  resourceId  String
  title       String
  body        String
  payload     Json
  readAt      DateTime?
  createdAt   DateTime         @default(now())
  expiresAt   DateTime

  pushDeliveries PushDelivery[]

  @@unique([eventId, userId])
  @@index([tenantId, userId, createdAt])
  @@index([userId, readAt, createdAt])
  @@index([expiresAt])
}

model PushDevice {
  id            String       @id @default(uuid())
  tenantId      String
  tenant        Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  expoPushToken String       @unique
  platform      PushPlatform
  appVersion    String?
  enabled       Boolean      @default(true)
  lastSeenAt    DateTime     @default(now())
  disabledAt    DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  deliveries PushDelivery[]

  @@index([tenantId, userId, enabled])
}

model PushDelivery {
  id               String             @id @default(uuid())
  notificationId   String
  notification     Notification       @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  pushDeviceId     String
  pushDevice       PushDevice         @relation(fields: [pushDeviceId], references: [id], onDelete: Cascade)
  status           PushDeliveryStatus @default(PENDING)
  ticketId         String?
  attempts         Int                @default(0)
  nextAttemptAt    DateTime           @default(now())
  lastError        String?
  sentAt           DateTime?
  receiptCheckedAt DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@unique([notificationId, pushDeviceId])
  @@index([status, nextAttemptAt])
  @@index([ticketId])
}

model Permission {
  id          String   @id @default(uuid())
  key         String   @unique
  description String
  category    String
  assignable  Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users UserPermission[]

  @@index([category])
}

model UserPermission {
  id String @id @default(uuid())

  userId String
  user   User   @relation("UserPermissionUser", fields: [userId], references: [id], onDelete: Cascade)

  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  grantedById String
  grantedBy   User   @relation("UserPermissionGrantedBy", fields: [grantedById], references: [id], onDelete: Restrict)

  effect PermissionEffect @default(ALLOW)

  createdAt DateTime @default(now())

  @@unique([userId, permissionId, tenantId])
  @@index([userId, tenantId])
  @@index([tenantId])
  @@index([permissionId])
  @@index([grantedById])
}

model Song {
  id              String    @id @default(uuid())
  title           String
  normalizedTitle String
  composer        String?
  originalKey     String
  content         String    @db.Text
  comments        String?   @db.Text
  bpm             Int?
  cifraUrl        String?   @db.Text
  letraUrl        String?   @db.Text
  audioUrl        String?   @db.Text
  videoUrl        String?   @db.Text
  isActive        Boolean   @default(true)
  deletedAt       DateTime?

  artistId String
  artist   Artist @relation(fields: [artistId], references: [id], onDelete: Restrict)

  createdById String?
  createdBy   User?   @relation("SongCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  updatedById String?
  updatedBy   User?   @relation("SongUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  ministries MinistrySong[]
  schedules  ScheduleSong[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, artistId, normalizedTitle])
  @@index([tenantId, normalizedTitle])
  @@index([tenantId, artistId])
}

model Artist {
  id             String    @id @default(uuid())
  name           String
  normalizedName String
  imageUrl       String?
  isActive       Boolean   @default(true)
  deletedAt      DateTime?

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  songs Song[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, normalizedName])
  @@index([tenantId, name])
}

model MinistrySong {
  id String @id @default(uuid())

  songId String
  song   Song   @relation(fields: [songId], references: [id], onDelete: Cascade)

  ministryId String
  ministry   Ministry @relation(fields: [ministryId], references: [id], onDelete: Cascade)

  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  isActive  Boolean   @default(true)
  deletedAt DateTime?

  @@unique([songId, ministryId])
  @@index([tenantId])
}

model AdminAuditLog {
  id         String   @id @default(uuid())
  actorId    String
  actorRole  Role
  action     String
  resource   String
  resourceId String?
  tenantId   String?
  requestId  String?
  payload    Json?
  createdAt  DateTime @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([resource, resourceId])
  @@index([tenantId])
  @@index([requestId])
  @@index([createdAt])
}

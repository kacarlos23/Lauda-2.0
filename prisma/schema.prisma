generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  GLOBAL_ADMIN
  TENANT_ADMIN
  MINISTRY_LEADER
  MEMBER
}

enum AssignmentStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum MemberStatus {
  PENDING
  ACTIVE
  INACTIVE
}

model Tenant {
  id        String   @id @default(uuid())
  name      String
  domain    String?  @unique
  isActive  Boolean  @default(true)
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users         User[]
  ministries    Ministry[]
  schedules     Schedule[]
  songs         Song[]
  artists       Artist[]
  memberInvites MemberInvite[]
  instruments   Instrument[]

  ministryMembers     MinistryMember[]
  scheduleAssignments ScheduleAssignment[]
  scheduleSongs        ScheduleSong[]
  ministrySongs       MinistrySong[]
  userInstruments     UserInstrument[]
  adminAuditLogs      AdminAuditLog[]
}

model MemberInvite {
  id String @id @default(uuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  ministryId String?
  ministry   Ministry? @relation(fields: [ministryId], references: [id], onDelete: Cascade)

  code      String    @unique
  active    Boolean   @default(true)
  isActive  Boolean   @default(true)
  deletedAt DateTime?
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([tenantId])
  @@index([ministryId])
  @@index([active])
}

model User {
  id        String  @id @default(uuid())
  email     String  @unique
  password  String
  name      String
  phone     String?
  avatarUrl String? @db.Text
  role      Role    @default(MEMBER)
  isActive  Boolean @default(true)
  deletedAt DateTime?

  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  ministries   MinistryMember[]
  schedules    ScheduleAssignment[]
  instruments  UserInstrument[]
  createdSongs Song[]               @relation("SongCreatedBy")
  updatedSongs Song[]               @relation("SongUpdatedBy")

  resetPasswordToken   String?   @unique
  resetPasswordExpires DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

model Instrument {
  id       String  @id @default(uuid())
  name     String
  colorHex String?
  isActive Boolean @default(true)
  deletedAt DateTime?

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  members UserInstrument[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, name])
  @@index([tenantId])
}

model UserInstrument {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  instrumentId String
  instrument   Instrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  isActive Boolean @default(true)
  deletedAt DateTime?

  createdAt DateTime @default(now())

  @@unique([userId, instrumentId])
  @@index([tenantId])
  @@index([instrumentId])
}

model Ministry {
  id          String  @id @default(uuid())
  name        String
  description String?
  isActive    Boolean @default(true)
  deletedAt   DateTime?

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  members       MinistryMember[]
  memberInvites MemberInvite[]
  schedules     Schedule[]
  songs         MinistrySong[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

model MinistryMember {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  ministryId String
  ministry   Ministry @relation(fields: [ministryId], references: [id], onDelete: Cascade)

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  roleId    String?
  role      String?
  skills    String[]     @default([])
  status    MemberStatus @default(PENDING)
  joinedAt  DateTime     @default(now())
  notes     String?
  isLeader  Boolean      @default(false)
  isActive  Boolean      @default(true)
  deletedAt DateTime?
  createdAt DateTime     @default(now())

  @@unique([userId, ministryId])
  @@index([ministryId])
  @@index([ministryId, status])
  @@index([tenantId])
}

model Schedule {
  id    String   @id @default(uuid())
  title String
  date  DateTime
  isActive Boolean @default(true)
  deletedAt DateTime?

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  ministryId String
  ministry   Ministry @relation(fields: [ministryId], references: [id], onDelete: Cascade)

  assignments ScheduleAssignment[]
  songs       ScheduleSong[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([tenantId, date])
  @@index([ministryId])
  @@index([tenantId, ministryId, date])
}

model ScheduleSong {
  id String @id @default(uuid())

  scheduleId String
  schedule   Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  songId String
  song   Song   @relation(fields: [songId], references: [id], onDelete: Cascade)

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  order     Int      @default(0)
  isActive  Boolean  @default(true)
  deletedAt DateTime?
  createdAt DateTime @default(now())

  @@unique([scheduleId, songId])
  @@index([tenantId])
  @@index([tenantId, scheduleId])
  @@index([songId])
}

model ScheduleAssignment {
  id String @id @default(uuid())

  scheduleId String
  schedule   Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  role     String // ex: "Guitarrista", "Bateria", "Recepção"
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  status    AssignmentStatus @default(PENDING)
  isActive  Boolean          @default(true)
  deletedAt DateTime?
  createdAt DateTime         @default(now())

  @@unique([scheduleId, userId])
  @@index([tenantId])
  @@index([tenantId, userId])
  @@index([tenantId, status])
}

model Song {
  id              String  @id @default(uuid())
  title           String
  normalizedTitle String
  composer        String?
  originalKey     String
  content         String  @db.Text
  bpm             Int?
  cifraUrl        String? @db.Text
  letraUrl        String? @db.Text
  audioUrl        String? @db.Text
  videoUrl        String? @db.Text
  isActive        Boolean @default(true)
  deletedAt       DateTime?

  artistId String
  artist   Artist @relation(fields: [artistId], references: [id], onDelete: Restrict)

  createdById String?
  createdBy   User?   @relation("SongCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  updatedById String?
  updatedBy   User?   @relation("SongUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  ministries MinistrySong[]
  schedules  ScheduleSong[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, artistId, normalizedTitle])
  @@index([tenantId, normalizedTitle])
  @@index([tenantId, artistId])
}

model Artist {
  id             String  @id @default(uuid())
  name           String
  normalizedName String
  imageUrl       String?
  isActive       Boolean @default(true)
  deletedAt      DateTime?

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  songs Song[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, normalizedName])
  @@index([tenantId, name])
}

model MinistrySong {
  id String @id @default(uuid())

  songId String
  song   Song   @relation(fields: [songId], references: [id], onDelete: Cascade)

  ministryId String
  ministry   Ministry @relation(fields: [ministryId], references: [id], onDelete: Cascade)

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  isActive Boolean @default(true)
  deletedAt DateTime?

  @@unique([songId, ministryId])
  @@index([tenantId])
}

model AdminAuditLog {
  id        String   @id @default(uuid())
  actorId   String
  actorRole Role
  action    String
  resource  String
  resourceId String?
  tenantId  String?
  payload   Json?
  createdAt DateTime @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([resource, resourceId])
  @@index([tenantId])
  @@index([createdAt])
}

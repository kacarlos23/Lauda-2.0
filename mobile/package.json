{
  "name": "mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "prebuild:web": "node ../scripts/validate-text-encoding.cjs && node ../scripts/validate-frontend-api.cjs --environment",
    "build:web": "expo export --platform web",
    "postbuild:web": "node ../scripts/validate-frontend-api.cjs --dist dist",
    "serve:web": "serve dist --config ../serve.json",
    "test": "jest --config jest.config.js",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {

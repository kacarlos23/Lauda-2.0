{
  "expo": {
    "name": "Lauda",
    "slug": "lauda",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/png/icon-512.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "lauda",
    "splash": {
      "image": "./assets/brand/png/lauda-symbol-light-512.png",
      "resizeMode": "contain",
      "backgroundColor": "#164C3C"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lauda.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/png/lauda-symbol-light-512.png",
        "backgroundColor": "#164C3C"
      },
      "package": "com.lauda.app",
      "edgeToEdgeEnabled": true,
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/brand/png/favicon-48.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "asyncRoutes": {
            "web": true,
            "default": "development"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/brand/png/lauda-symbol-light-512.png",
          "color": "#1F6F55",
          "defaultChannel": "schedules"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "ba27fc5e-f4ed-46b8-bd7e-1331b219bbc8"
      }
    },
    "owner": "kacarlos23"
  }
}

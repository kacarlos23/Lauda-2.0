{
  "expo": {
    "name": "Lauda",
    "slug": "lauda",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/png/icon-512.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "scheme": "lauda",
    "splash": {
      "image": "./assets/brand/png/lauda-symbol-light-512.png",
      "resizeMode": "contain",
      "backgroundColor": "#164C3C"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lauda.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/png/lauda-symbol-light-512.png",
        "backgroundColor": "#164C3C"
      },
      "package": "com.lauda.app",
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/brand/png/favicon-48.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}

DATABASE_URL="postgresql://postgres:postgres@localhost:5434/lauda2"
JWT_SECRET="replace-with-at-least-32-random-bytes"
REFRESH_JWT_SECRET="replace-with-a-different-32-byte-random-secret"
JWT_EXPIRES_IN="15m"
REFRESH_JWT_EXPIRES_IN="7d"
PASSWORD_RESET_PEPPER="replace-with-an-independent-32-byte-random-secret"
PASSWORD_RESET_PEPPER_VERSION="1"
PASSWORD_RESET_MAX_ATTEMPTS="5"
PASSWORD_RESET_DELIVERY_MODE="disabled"
# Production must use SMTP delivery and configure every value below.
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER="smtp-user"
# SMTP_PASSWORD="replace-with-a-secret"
# SMTP_FROM="Lauda <no-reply@example.com>"
RATE_LIMIT_HMAC_KEY="replace-with-another-independent-32-byte-random-secret"
RATE_LIMIT_ENABLED="true"
RATE_LIMIT_STORE="memory"
# Production must use redis and set the URL below.
# RATE_LIMIT_REDIS_URL="redis://localhost:6379"
RATE_LIMIT_REDIS_CONNECT_TIMEOUT_MS="3000"
RATE_LIMIT_FAILURE_MODE="closed"
# Set to 1 only when exactly one trusted reverse proxy is in front of Express.
# The bundled Cloudflare Tunnel launcher uses 1.
TRUST_PROXY_HOPS="0"
MEMBER_INVITE_BASE_URL="https://laudaapp.com/convite"
HOST="0.0.0.0"
PORT=3000

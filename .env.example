DATABASE_URL="postgresql://postgres:replace-with-a-local-random-password@localhost:5434/lauda2"
# Local Compose only. Set explicitly and keep it aligned with DATABASE_URL.
POSTGRES_PASSWORD="replace-with-a-local-random-password"
# Production: managed injection is mandatory; never copy staging namespaces or KMS keys.
DEPLOYMENT_ENVIRONMENT="development"
SECRETS_PROVIDER="local"
# SECRET_NAMESPACE="lauda/production/api"
# KMS_KEY_ID="managed-kms-key-id"
SECRET_ROTATION_DAYS="90"
JWT_SECRET="replace-with-at-least-32-random-bytes"
REFRESH_JWT_SECRET="replace-with-a-different-32-byte-random-secret"
JWT_EXPIRES_IN="15m"
REFRESH_JWT_EXPIRES_IN="7d"
JWT_ISSUER="lauda-api"
JWT_ACCESS_AUDIENCE="lauda-clients"
JWT_REFRESH_AUDIENCE="lauda-refresh"
PASSWORD_RESET_PEPPER="replace-with-an-independent-32-byte-random-secret"
MFA_ENCRYPTION_KEY="replace-with-another-independent-32-byte-random-secret"
GLOBAL_ADMIN_MFA_REQUIRED="true"
ADMIN_STEP_UP_REQUIRED="true"
ADMIN_STEP_UP_TTL_MINUTES="10"
SUPPORT_ACCESS_MAX_MINUTES="60"
PASSWORD_RESET_PEPPER_VERSION="1"
PASSWORD_RESET_MAX_ATTEMPTS="5"
PASSWORD_RESET_DELIVERY_MODE="disabled"
# Production must use SMTP delivery and configure every value below.
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER="smtp-user"
# SMTP_PASSWORD="replace-with-a-secret"
# SMTP_FROM="Lauda <no-reply@example.com>"
RATE_LIMIT_HMAC_KEY="replace-with-another-independent-32-byte-random-secret"
RATE_LIMIT_ENABLED="true"
RATE_LIMIT_STORE="memory"
# Production must use redis and set the URL below.
# RATE_LIMIT_REDIS_URL="redis://localhost:6379"
RATE_LIMIT_REDIS_CONNECT_TIMEOUT_MS="3000"
RATE_LIMIT_FAILURE_MODE="closed"
# Real-time events use the rate-limit Redis URL by default. Set a separate URL only when desired.
REALTIME_ENABLED="true"
# REALTIME_REDIS_URL="rediss://user:password@redis.example.com:6379"
REALTIME_TICKET_TTL_SECONDS="30"
OUTBOX_POLL_MS="1000"
NOTIFICATION_RETENTION_DAYS="90"
PUSH_NOTIFICATIONS_ENABLED="false"
# EXPO_PUSH_ACCESS_TOKEN="replace-with-eas-push-access-token"
# Set to 1 only when exactly one trusted reverse proxy is in front of Express.
# The bundled Cloudflare Tunnel launcher uses 1.
TRUST_PROXY_HOPS="0"
MEMBER_INVITE_BASE_URL="https://laudaapp.com/convite"
HOST="0.0.0.0"
PORT=3000
